[Unit]
Description=Pi Router resumable provisioning controller
Wants=cloud-init.target systemd-machine-id-commit.service systemd-sysusers.service systemd-tmpfiles-setup.service NetworkManager.service
After=local-fs.target cloud-init.target systemd-machine-id-commit.service systemd-sysusers.service systemd-tmpfiles-setup.service NetworkManager.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/pi-router-image/pi_router_image_controller.py
KillMode=control-group
TimeoutStartSec=40min
StandardOutput=journal
StandardError=journal
