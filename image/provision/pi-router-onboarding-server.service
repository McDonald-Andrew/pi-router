[Unit]
Description=Pi Router temporary Proton onboarding server
Requires=pi-router-onboarding-backend.service
BindsTo=pi-router-onboarding-backend.service
PartOf=pi-router-onboarding-backend.service
After=network.target pi-router-onboarding-backend.service
ConditionPathExists=/run/pi-router-image/onboarding.sock
ConditionPathExists=/run/pi-router-image/onboarding.crt
ConditionPathExists=/run/pi-router-image/onboarding.key
ConditionPathExists=/usr/local/share/pi-router-web/version.txt

[Service]
Type=simple
User=pi-router-onboarding
Group=pi-router-onboarding
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/pi-router-image/onboarding_server.py --config /etc/pi-router.conf --assets /usr/local/share/pi-router-onboarding --socket /run/pi-router-image/onboarding.sock --version-file /usr/local/share/pi-router-web/version.txt --port 8080
LoadCredential=tls.crt:/run/pi-router-image/onboarding.crt
LoadCredential=tls.key:/run/pi-router-image/onboarding.key
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=10s
KillMode=mixed

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=192.168.50.0/24
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:8080
KeyringMode=private
TasksMax=16
LimitNOFILE=64
LimitCORE=0
MemoryMax=128M
MemorySwapMax=0

StandardOutput=journal
StandardError=journal
