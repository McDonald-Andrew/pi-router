[Unit]
Description=Refresh Proton Router VPN endpoint blocklist
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
NotifyAccess=all

Environment=VPN_USER=admin
Environment=LAN_IF=eth0

ExecStart=/usr/local/sbin/proton-router-vpn-refresh

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

TimeoutStartSec=30min
