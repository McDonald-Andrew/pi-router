#!/bin/sh
set -eu

umask 077

KEYRING_DIR="$HOME/.local/share/keyrings"

die() {
    echo "proton-keyring-init: $*" >&2
    exit 1
}

# Never modify an existing keyring installation.
if [ -d "$KEYRING_DIR" ]; then
    if [ -e "$KEYRING_DIR/default" ] ||
       find "$KEYRING_DIR" -maxdepth 1 -type f -name '*.keyring' \
           -print -quit | grep -q .
    then
        echo "proton-keyring-init: existing keyring found; leaving it untouched"
        exit 0
    fi
fi

mkdir -p "$KEYRING_DIR"
chmod 700 "$KEYRING_DIR"

RUNTIME_DIR=$(mktemp -d /tmp/proton-keyring-init.XXXXXX)
chmod 700 "$RUNTIME_DIR"

cleanup() {
    rm -rf "$RUNTIME_DIR"
}
trap cleanup EXIT HUP INT TERM

XDG_RUNTIME_DIR="$RUNTIME_DIR" \
dbus-run-session -- sh -c '
    set -eu

    printf "\000" |
        /usr/bin/gnome-keyring-daemon \
            --unlock \
            --components=secrets \
            >/dev/null

    alias=$(
        /usr/bin/gdbus call \
            --session \
            --dest org.freedesktop.secrets \
            --object-path /org/freedesktop/secrets \
            --method org.freedesktop.Secret.Service.ReadAlias \
            default
    )

    case "$alias" in
        *"/org/freedesktop/secrets/collection/login"*)
            ;;
        *)
            echo "proton-keyring-init: default Secret Service alias is not login" >&2
            exit 1
            ;;
    esac
'

[ -s "$KEYRING_DIR/login.keyring" ] ||
    die "login.keyring was not created"

chmod 700 "$KEYRING_DIR"
chmod 600 "$KEYRING_DIR/login.keyring"

echo "proton-keyring-init: empty-password login keyring initialized"
