#!/bin/sh
set -eu

CONFIG_FILE="/etc/pi-router.conf"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
NM_CLEANUP="$SCRIPT_DIR/protonvpn-nm-cleanup"

[ -r "$CONFIG_FILE" ] || exit 1
. "$CONFIG_FILE"

[ -n "${WAN_IF:-}" ] || exit 1

[ -x "$NM_CLEANUP" ] || exit 1

close_bootstrap() {
    sudo -n /usr/sbin/nft flush chain inet router_filter host_wan_bootstrap \
        2>/dev/null || true
}

prepare_connection_attempt() {
    "$NM_CLEANUP" --prepare-connect || {
        echo "protonvpn-autoconnect: stale Proton cleanup failed" >&2
        return 1
    }
}

prune_connected_profiles() {
    "$NM_CLEANUP" --prune-connected ||
        echo "protonvpn-autoconnect: WARNING - redundant profile pruning failed" >&2
}

force_wireguard() {
    python3 - "${XDG_CONFIG_HOME:-$HOME/.config}/Proton/VPN/settings.json" <<'PY'
import json
import os
import sys
from pathlib import Path
from tempfile import TemporaryDirectory

try:
    path = Path(sys.argv[1]).resolve()
    try:
        settings = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        settings = {}

    if not isinstance(settings, dict):
        raise ValueError("expected a JSON object")

    if settings.get("protocol") != "wireguard":
        settings["protocol"] = "wireguard"
        os.umask(0o077)
        path.parent.mkdir(parents=True, exist_ok=True)
        with TemporaryDirectory(dir=path.parent) as directory:
            replacement = Path(directory) / path.name
            replacement.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
            replacement.replace(path)
except (OSError, RuntimeError, ValueError) as error:
    sys.exit(f"protonvpn-autoconnect: unable to set WireGuard in Proton settings: {error}")
PY
}

proton_device_type() {
    nmcli -g GENERAL.TYPE device show proton0 2>/dev/null
}

# Always fail closed when this script exits.
trap close_bootstrap EXIT

# Signals also cause an exit, which triggers close_bootstrap.
trap 'exit 1' HUP INT TERM

# Wait for the configured WAN to receive a usable IPv4 default route.
i=0
while ! /usr/sbin/ip -4 route show default dev "$WAN_IF" |
    grep -q '^default '
do
    i=$((i + 1))
    [ "$i" -ge 60 ] && exit 1
    sleep 1
done

# Wait for the desktop Secret Service/keyring.
i=0
while ! busctl --user --list 2>/dev/null | grep -q '^org.freedesktop.secrets'; do
    i=$((i + 1))
    [ "$i" -ge 30 ] && exit 1
    sleep 1
done

force_wireguard

# A live ProTUN session must be replaced for the setting to take effect.
if protonvpn status 2>/dev/null | grep -q '^Status: Connected'; then
    case "$(proton_device_type || true)" in
        wireguard)
            prune_connected_profiles
            exit 0
            ;;
        tun)
            echo "protonvpn-autoconnect: replacing active ProTUN session with WireGuard" >&2
            timeout 30s protonvpn disconnect || true
            ;;
        *)
            echo "protonvpn-autoconnect: unable to verify the connected Proton device type" >&2
            exit 1
            ;;
    esac
fi

# Start from a closed gate, then temporarily permit Pi-originated
# raw-WAN traffic so Proton can refresh DNS/API/server information.
close_bootstrap
sudo -n /usr/sbin/nft add rule inet router_filter host_wan_bootstrap accept

# Proton can occasionally fail its first managed WireGuard connection while the local agent/session is settling.
# Keep the bootstrap gate open across a small number of bounded retries.
# The EXIT trap above still closes raw-WAN bootstrap on every success or failure path.
attempt=1
max_attempts=3

while [ "$attempt" -le "$max_attempts" ]; do
    # Every attempt starts without stale active connections or redundant
    # inactive Proton-generated proton0 profiles.
    prepare_connection_attempt || exit 1

    if timeout 90s protonvpn connect ||
        protonvpn status 2>/dev/null | grep -q '^Status: Connected'; then
        if [ "$(proton_device_type || true)" = wireguard ]; then
            prune_connected_profiles
            exit 0
        fi
        echo "protonvpn-autoconnect: Proton did not activate WireGuard on proton0" >&2
    fi

    # A failed CLI attempt may leave both an active zombie and a saved profile.
    prepare_connection_attempt || exit 1

    if [ "$attempt" -ge "$max_attempts" ]; then
        echo "protonvpn-autoconnect: failed after $max_attempts attempts" >&2
        exit 1
    fi

    echo "protonvpn-autoconnect: connect attempt $attempt failed; retrying in 5 seconds..." >&2
    sleep 5
    attempt=$((attempt + 1))
done
